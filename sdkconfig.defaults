# Target: ESP32-S3-WROOM-1U N16R8 dev board (YD-ESP32-S3 layout), the same
# board as tspl-station.
CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash. The default 2 MB silently truncates the partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM. The stream ring (512 KB), the Opus pseudostack (120 KB),
# the decoder state and announcement clips live here. Only allocations under
# 4 KB default to internal RAM: internal is the scarce resource (~60 KB free
# on a SuperMini), and the big transient ones -- HTTP and TLS buffers during
# a clip download -- are happy in PSRAM. (tspl-station used 16 KB for its
# USB host buffers; downlink has none, and DMA buffers ask for internal
# explicitly.)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Opus decode reads its pseudostack out of PSRAM on every frame; the bigger
# data cache is what micro-opus recommends for the S3.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Console on UART0 via the board's UART bridge port, as on tspl-station.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Radio and HTTP on core 0; decode and I2S on core 1.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# https:// stream URLs verify against the common root bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Announcement clips arrive over HTTPS. TLS allocations go to PSRAM, and the
# record buffers are freed between uses, so a fetch doesn't take ~30-40 KB of
# the tight internal heap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# MQTT 5: the will delay hides WiFi roams from the retained status topic.
CONFIG_MQTT_PROTOCOL_5=y

# Unattended portal: 5 min instead of tspl-station's 30. At a remote site
# "no known network" is far more often a rebooting router than a person with
# a phone; while the portal is up the board is not rejoining. BOOT still
# opens it on demand, and someone on it keeps it open.
CONFIG_PROVISION_TIMEOUT_S=300

# Stack high-water marks in the heartbeat and the MQTT status.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# The main task builds the MQTT status JSON; the 3.5 KB default is tight.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Unattended: a CPU starved for 5 s (idle task not running) is a hang, so
# panic and reboot rather than print a warning nobody reads. The reset
# reason ("task_wdt") lands in the retained status.
CONFIG_ESP_TASK_WDT_PANIC=y

# OTA: a new image boots on probation and the bootloader goes back to the
# old one unless it reaches the broker (updater_mark_valid). This lives in
# the bootloader, so a board needs one USB flash before its first OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Empty here so the file stays safe to commit; see sdkconfig.defaults.local.
CONFIG_NETLINK_SSID0=""
CONFIG_NETLINK_PASS0=""
CONFIG_UPLINK_URI=""
CONFIG_UPLINK_USER=""
CONFIG_UPLINK_PASS=""
